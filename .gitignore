*.zip
main.py
.python-version
.venv/
uv.lock
.DS_Store
__pycache__/
*.py[cod]
*.coverage
htmlcov/
.pytest_cache/
.idea/
.vscode/
*.log

# dbt
dbt/target/
dbt/dbt_packages/
dbt/logs/
