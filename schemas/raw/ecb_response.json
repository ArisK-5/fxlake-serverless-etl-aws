{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fxlake.dev/schemas/raw/ecb_response.json",
  "title": "ECB SDMX-JSON Response",
  "description": "JSON Schema for the ECB Statistics Data Warehouse SDMX-JSON exchange rates response. Validates only the structural subset that the ECB ingestion handler parses.",
  "type": "object",
  "required": ["dataSets", "structure"],
  "properties": {
    "dataSets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["series"],
        "properties": {
          "series": {
            "type": "object",
            "minProperties": 1,
            "description": "Series keyed by colon-delimited dimension indices (e.g. '0:0:0:0:0').",
            "patternProperties": {
              "^[0-9]+(:[0-9]+)*$": {
                "type": "object",
                "properties": {
                  "observations": {
                    "type": "object",
                    "patternProperties": {
                      "^[0-9]+$": {
                        "type": "array",
                        "minItems": 1,
                        "items": {
                          "type": ["number", "null"]
                        }
                      }
                    },
                    "additionalProperties": false
                  }
                }
              }
            }
          }
        }
      }
    },
    "structure": {
      "type": "object",
      "required": ["dimensions"],
      "properties": {
        "dimensions": {
          "type": "object",
          "required": ["series", "observation"],
          "properties": {
            "series": {
              "type": "array",
              "minItems": 1,
              "description": "Must contain at least a CURRENCY dimension.",
              "items": {
                "type": "object",
                "required": ["id", "values"],
                "properties": {
                  "id": { "type": "string" },
                  "values": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": ["id"],
                      "properties": {
                        "id": { "type": "string" }
                      }
                    }
                  }
                }
              }
            },
            "observation": {
              "type": "array",
              "minItems": 1,
              "description": "Must contain at least a TIME_PERIOD dimension.",
              "items": {
                "type": "object",
                "required": ["id", "values"],
                "properties": {
                  "id": { "type": "string" },
                  "values": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": ["id"],
                      "properties": {
                        "id": { "type": "string" }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
