{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fxlake.dev/schemas/raw/fred_response.json",
  "title": "FRED Series Observations Response",
  "description": "JSON Schema for the FRED API /series/observations endpoint response.",
  "type": "object",
  "required": ["observations"],
  "properties": {
    "realtime_start": {
      "type": "string",
      "format": "date"
    },
    "realtime_end": {
      "type": "string",
      "format": "date"
    },
    "observation_start": {
      "type": "string",
      "format": "date"
    },
    "observation_end": {
      "type": "string",
      "format": "date"
    },
    "units": { "type": "string" },
    "output_type": { "type": "integer" },
    "file_type": { "type": "string" },
    "order_by": { "type": "string" },
    "sort_order": { "type": "string" },
    "count": {
      "type": "integer",
      "minimum": 0
    },
    "offset": {
      "type": "integer",
      "minimum": 0
    },
    "limit": {
      "type": "integer",
      "minimum": 1
    },
    "observations": {
      "type": "array",
      "description": "Array of observation objects. Value is a string ('.' for missing, numeric string otherwise).",
      "items": {
        "type": "object",
        "required": ["date", "value"],
        "properties": {
          "realtime_start": { "type": "string", "format": "date" },
          "realtime_end": { "type": "string", "format": "date" },
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "description": "Observation date (ISO 8601)."
          },
          "value": {
            "type": "string",
            "description": "Observation value as string. '.' indicates missing/unreleased data."
          }
        }
      }
    }
  }
}
